{
  "_schema": {
    "description": "Sample data for the Creator Network visualization. Replace this file with your own creators.json (same structure) to see your Notion database rendered as a force-directed graph.",
    "creator_fields": {
      "id": "Unique string id. Usually the Instagram handle without @.",
      "name": "Display name shown on the node.",
      "handle": "Instagram handle without @. Used to link out to instagram.com.",
      "categories": "Array of tags / niches. Edges are drawn between creators that share categories.",
      "followers": "Optional integer. Used when 'node size = followers' is selected.",
      "bio": "Optional short description, shown in the details panel.",
      "follows": "Optional array of other creator ids this creator follows.",
      "collaborations": "Optional array of other creator ids this creator has collaborated with."
    },
    "edge_types": {
      "category": "Two creators share one or more categories.",
      "follow": "Directional 'follows' relationships (mutual follows are weighted 2x).",
      "collab": "Explicit collaboration between two creators (strongest weight)."
    }
  },
